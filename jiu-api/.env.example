# Server Configuration
PORT=3002
NODE_ENV=development

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/jiujitsu_dev

# Authentication (JWT)
JWT_SECRET=your-super-secret-jwt-key
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# CORS / Frontend URL
FRONTEND_URL=http://localhost:5173

# Email Service (Nodemailer / SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=false
SMTP_USER=user@domain.com
SMTP_PASS=your-smtp-password
SMTP_FROM=no-reply@domain.com

# Cloud Storage (Cloudflare R2 / AWS S3)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=jiu-platform
R2_PUBLIC_URL=https://your-public-url.r2.dev

# ==============================================================================
# Observabilidade & Monitoração (Grafana Loki & Grafana Tempo)
# ==============================================================================
# 🛡️ RESILIÊNCIA: Se as variáveis abaixo estiverem vazias ou ausentes,
# a aplicação funcionará 100% normalmente em modo fallback (logs no console, tracing no-op).

# Tracing com OpenTelemetry (Grafana Tempo)
# Defina OTEL_ENABLED=true para ativar o rastreamento e exportação de traces
OTEL_ENABLED=false
OTEL_SERVICE_NAME=jiu-api
# Endpoint OTLP HTTP (porta padrão 4318 do Tempo ou OTel Collector)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Autenticação básica para o OTEL/Tempo (opcional)
OTEL_USER=
OTEL_PASSWORD=
# Alternativamente, cabeçalhos brutos (padrão OpenTelemetry spec):
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64>


# Logging Estruturado (Grafana Loki)
# Se LOKI_HOST estiver vazio, os logs serão emitidos apenas no stdout do terminal
LOKI_HOST=
# Autenticação básica para o Loki (opcional, se o servidor exigir)
LOKI_USER=
LOKI_PASSWORD=

# Nível mínimo de log: trace, debug, info, warn, error, fatal
LOG_LEVEL=info
